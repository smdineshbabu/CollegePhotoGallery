{
  "expo": {
    "name": "College Photo Gallery",
    "slug": "college-photo-gallery",
    "scheme": "collegegallery",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.college.photogallery",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiUrl": "http://10.73.154.112:5000/api",
      "eas": {
        "projectId": "49f3461c-3e90-4754-88f3-37e39d6e4c19"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}